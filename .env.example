# === 데이터베이스 (PostgreSQL) ===
# Neon / Vercel Postgres / Supabase 등에서 발급한 연결 문자열
# 예: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# === 고도몰 연동 ===
# 기존 쇼핑몰 기본 도메인 (상품 URL 생성/스크래핑 기준)
GODOMALL_BASE_URL="https://viaelite.co.kr"
# (선택) 고도몰 프로 Open API 사용 시 — 관리자에서 발급되는 값
GODOMALL_API_KEY=""
GODOMALL_API_SECRET=""

# === AI 착용샷 생성 ===
# 사용 서비스 확정 후 채우기 (예: OpenAI / Gemini / Fal / Replicate 등)
AI_PROVIDER="mock"          # mock | openai | gemini | fal | replicate
AI_API_KEY=""

# === 배포/SEO ===
# 배포 도메인 (metadata·sitemap·robots 기준). 예: https://donbeon-luxury.com
SITE_URL="http://localhost:3000"
# 검색엔진 소유확인 코드 (발급 후 채우기)
NAVER_SITE_VERIFICATION=""
GOOGLE_SITE_VERIFICATION=""

# === 인증/세션 ===
# 세션 쿠키 서명 키 (운영에서는 반드시 임의의 긴 값으로 교체)
AUTH_SECRET="change-me-to-a-long-random-string"

# === 어드민 로그인 ===
ADMIN_USER="admin"
ADMIN_PASSWORD="여기에-원하는-비밀번호"

# === 실명(본인)인증 ===
# 본인확인기관 연동 provider. 계약 전에는 mock 이 통과 처리.
IDENTITY_PROVIDER="mock"    # mock | nice | danal | toss

# 정산 민감정보 암호화 키 (운영에서 임의의 긴 값으로 교체)
SETTLEMENT_SECRET="change-me-long-random"

# 정산 서류 비공개 Blob (Vercel Storage: Private + prefix DOCS)
DOCS_READ_WRITE_TOKEN=""
